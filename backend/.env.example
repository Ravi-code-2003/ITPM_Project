PORT=5000
NODE_ENV=development

MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
