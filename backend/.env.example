PORT=5000
NODE_ENV=development

MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# SMTP (Forgot Password / Notifications)
EMAIL_FROM=no-reply@example.com
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_mailtrap_username
EMAIL_PASS=your_mailtrap_password
EMAIL_SECURE=false
EMAIL_AUTH_METHOD=PLAIN
EMAIL_REQUIRE_TLS=false

AI_PROVIDER=ollama
AI_TIMEOUT_MS=120000
AI_RETRY_ATTEMPTS=1
AI_CONTEXT_LIMIT=5
AI_TEMPERATURE=0.2

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_ENDPOINT=/api/chat
OLLAMA_MODEL=hhao/qwen2.5-coder-tools:3b

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_ENDPOINT=/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key

XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_ENDPOINT=/chat/completions
XAI_MODEL=grok-2-latest
XAI_API_KEY=your_xai_api_key

# Backward-compatible legacy settings (optional)
OLLAMA_TIMEOUT_MS=120000
OLLAMA_RETRY_ATTEMPTS=1
OLLAMA_CONTEXT_LIMIT=5
OLLAMA_TEMPERATURE=0.2
AI_DB_CONTEXT_MAX_ITEMS=20

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
AI_MAX_CHAT_CHARACTERS=150000
